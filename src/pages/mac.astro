    @keyframes macd-shake{ 0%,100%{ transform:translateX(0); } 25%{ transform:translateX(-5px); } 75%{ transform:translateX(5px); } }
    .macd-hotspot{ position:absolute; z-index:45; background:transparent; border:none; border-radius:11px; cursor:pointer; transition:opacity .25s, left .35s var(--ease), top .35s var(--ease), width .35s var(--ease), height .35s var(--ease); }
    .macd-callout{ position:absolute; z-index:46; display:flex; align-items:center; gap:8px; max-width:230px; padding:9px 13px; background:#fff; color:#160a12; border-radius:11px; font-size:13px; font-weight:700; box-shadow:0 16px 36px -10px rgba(0,0,0,0.5); pointer-events:none; }
    .macd-callout-arrow{ width:9px; height:9px; flex:0 0 9px; background:#eb336e; }
    .macd-callout--right{ transform:translateY(-50%); }
    .macd-callout--right .macd-callout-arrow{ clip-path:polygon(100% 0,100% 100%,0 50%); }
    .macd-callout--left{ transform:translate(-100%,-50%); flex-direction:row-reverse; }
    .macd-callout--left .macd-callout-arrow{ clip-path:polygon(0 0,0 100%,100% 50%); }
    .macd-callout--bottom{ transform:translateX(0); }
    .macd-callout--bottom .macd-callout-arrow{ clip-path:polygon(0 100%,100% 100%,50% 0); }
    .macd-floater{ position:absolute; left:16px; bottom:16px; z-index:50; display:flex; align-items:flex-start; gap:11px; width:288px; max-width:74%; padding:13px 14px; border-radius:15px; background:rgba(22,17,28,0.74); backdrop-filter:blur(30px) saturate(190%); -webkit-backdrop-filter:blur(30px) saturate(190%); border:1px solid rgba(255,255,255,0.14); box-shadow:0 22px 50px -16px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.18); color:#f3eef1; }
    .macd-floater-mark{ width:24px; height:24px; flex:0 0 24px; margin-top:1px; color:#fff; }
    .macd-floater-body{ flex:1; min-width:0; }
    .macd-floater-task{ font-size:11px; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; color:rgba(255,255,255,0.5); margin-bottom:3px; }
    .macd-floater-step{ font-size:14px; font-weight:600; color:#fff; line-height:1.35; }
    .macd-floater-meta{ display:flex; align-items:center; justify-content:space-between; margin-top:9px; font-size:11px; color:rgba(255,255,255,0.55); }
    .macd-floater-dots{ display:flex; gap:4px; } .macd-floater-dots span{ width:16px; height:3px; border-radius:999px; background:rgba(255,255,255,0.22); } .macd-floater-dots span.on{ background:#eb336e; }
    .macd-floater-x{ background:none; border:none; color:rgba(255,255,255,0.5); cursor:pointer; font-size:13px; padding:2px 4px; }
    .macd-floater-x:hover{ color:#fff; }

    /* ---- success toast ---- */
    .macd-toast{ position:absolute; left:50%; bottom:84px; transform:translateX(-50%); z-index:55; display:flex; align-items:center; gap:11px; max-width:80%; padding:13px 20px; border-radius:14px; background:rgba(22,17,28,0.82); backdrop-filter:blur(28px) saturate(190%); -webkit-backdrop-filter:blur(28px) saturate(190%); border:1px solid rgba(255,255,255,0.16); box-shadow:0 24px 50px -16px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.2); color:#fff; font-size:13.5px; font-weight:600; animation:macd-pop .25s var(--ease); }
    .macd-toast-check{ width:24px; height:24px; flex:0 0 24px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#34c759; color:#fff; }

    @media (max-width:760px){
      .macd-win{ font-size:12px; }
      .macd-mail{ grid-template-columns:120px 1fr; } .macd-mail-list{ display:none; }
      .macd-portal{ grid-template-columns:140px 1fr; }
      .macd-settings{ grid-template-columns:150px 1fr; }
      .macd-floater{ width:auto; right:16px; }
      .macd-appicon{ width:34px; height:34px; }
    }
    @media (prefers-reduced-motion:reduce){
      .macd-corner.is-hot .macd-corner-glow, .macd-hint.is-bounce, .macd-ring.is-ready, .macd-pal-glow, .macd-pal-state .macd-pal-glow{ animation:none; }
      .macd-spotlight, .macd-ring, .macd-hotspot{ transition:opacity .2s; }
    }

    /* =========================================================
       HOW-IT-WORKS MOCKS — rendered SwiftUI screenshots (see tools/mockshot.swift)
       ========================================================= */
    .hiw-img{
      margin-top:auto; align-self:stretch; width:100%; height:auto; display:block;
      border-radius:14px; border:1px solid var(--line); box-shadow:var(--shadow-sm);
    }

    /* FOOTER */
    .foot{ padding:48px 0 32px; }
    .foot__top{ display:flex; justify-content:space-between; align-items:flex-end; gap:24px; flex-wrap:wrap; padding-bottom:30px; border-bottom:1.5px solid var(--line); }
    .foot__brand{ display:flex; align-items:center; gap:12px; font-weight:800; font-size:28px; letter-spacing:-0.025em; color:var(--ink); }
    .foot__brand .logo{ width:42px; height:42px; }
    .foot__nav{ display:flex; flex-wrap:wrap; gap:18px; font-size:14px; color:var(--fg-soft); }
    .foot__nav a{ transition:color .15s; }
    .foot__nav a:hover{ color:var(--raz); }
    .foot__row{
      display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, max-content));
      gap:24px 72px; margin:32px 0;
    }
    .foot__col h5{ font-size:11px; letter-spacing:0.18em; text-transform:uppercase; color:var(--fg-dim); margin-bottom:12px; font-weight:800; }
    .foot__col a{ display:block; padding:4px 0; font-size:13px; color:var(--ink); opacity:0.75; transition:all .15s; }
    .foot__col a:hover{ opacity:1; color:var(--raz); }
    .foot__base{ padding-top:18px; border-top:1px solid var(--line); display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px; font-size:12px; color:var(--fg-dim); font-weight:600; }

    @media (max-width:900px){
      .nav__inner{ padding:8px 8px 8px 16px; }
